{
  "name": "mcp-server-microsoft-paint-nodejs",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx/esm --test --test-concurrency=1 \"tests/unit/*.test.ts\"",
    "test:e2e": "node --import tsx/esm --test \"tests/e2e/*.test.ts\"",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/server.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "koffi": "^3.1.4",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.1.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  },
  "allowScripts": {
    "koffi@3.1.4": true
  }
}
